<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.subtlesight</groupId><artifactId>subtlesight-parent</artifactId><version>1.0.0-SNAPSHOT</version></parent>
  <artifactId>server-app</artifactId>
  <dependencies>
    <dependency><groupId>com.subtlesight</groupId><artifactId>core-application</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>storage-sqlite</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>storage-blob</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>search-lucene</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>runtime-jobs</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>source-connectors</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>calendar-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>calendar-connectors</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>calendar-storage-sqlite</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>discovery-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>document-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>story-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>signal-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>research-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>evidence-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>watchlist-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>report-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>agent-engine</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>provider-ai</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>provider-search</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.subtlesight</groupId><artifactId>observability</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId>
        <executions><execution><id>copy-web-ui</id><phase>process-resources</phase><goals><goal>copy-resources</goal></goals>
          <configuration><outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
            <resources><resource><directory>../web-ui/dist</directory><filtering>false</filtering></resource></resources>
            <skip>${skip.web}</skip>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
