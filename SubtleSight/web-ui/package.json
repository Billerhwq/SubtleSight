    "@tiptap/starter-kit": "3.28.0",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "6.30.2",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
